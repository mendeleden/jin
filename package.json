{
  "name": "jin",
  "version": "0.8.11",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "bin": {
    "jin": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile jin",
    "typecheck": "tsc --noEmit",
    "test:integration": "docker compose -f test/docker-compose.integration.yml up -d --wait && bun test test/integration.test.ts; docker compose -f test/docker-compose.integration.yml down -v"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "typescript": "^5.7",
    "vitepress": "^1.6.4"
  }
}
