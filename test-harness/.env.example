# Fill in the API keys for the tools you want to test.
# You only need the ones you plan to use.

# Gemini CLI (free tier: 1000 req/day with Google account)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI Codex CLI (requires paid account)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (for OpenCode, which supports multiple providers)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
